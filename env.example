# Copiez ce fichier en ".env" puis remplacez les valeurs par celles de votre inbox Mailtrap
# (Mailtrap > Email Testing > Inboxes > votre inbox > SMTP Settings)
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=votre_username_mailtrap
MAILTRAP_PASSWORD=votre_password_mailtrap
EXPEDITEUR=bot-rpa@tp2.local
